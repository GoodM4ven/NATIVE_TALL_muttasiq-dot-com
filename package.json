{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "format:blade": "blade-formatter --write --config .bladeformatterrc \"resources/views/**/*.blade.php\"",
        "format:prettier": "prettier --write --config .prettierrc \"resources/{css,js}/**/*.{css,js}\"",
        "build": "vite build",
        "dev": "vite"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "blade-formatter": "^1.43.0",
        "eslint": "^10.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "laravel-vite-plugin": "^3.1.0",
        "playwright": "^1.59.1",
        "prettier": "^3.7.4",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@formkit/auto-animate": "^0.9.0",
        "@ryangjchandler/alpine-hooks": "^1.0.0",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.19",
        "animejs": "^4.2.2",
        "axios": "^1.16.1",
        "color": "^5.0.3",
        "concurrently": "^10.0.3",
        "dayjs": "^1.11.19",
        "dayjs-hijri": "^1.0.1",
        "fitty": "^2.4.2",
        "laravel-hot-refresh": "^1.0.7",
        "ldrs": "^1.1.9",
        "tailwindcss": "^4.2.0",
        "tippy.js": "^6.3.7",
        "viewerjs": "^1.11.7"
    }
}
